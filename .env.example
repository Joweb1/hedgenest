# Server Configuration
PORT=3333

# MongoDB Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/hedgenest

# JWT Secret Key
SECRET_KEY=your_jwt_secret_key_here
SECRET=your_jwt_secret_key_here

# Google OAuth Credentials
Google_Client_ID=your_google_client_id_here
Google_Client_Secret=your_google_client_secret_here
callbackURL=http://localhost:3333/api/v1/auth/google/callback

# Cloudinary Storage
cloudName=your_cloudinary_cloud_name
cloudinaryApiKey=your_cloudinary_api_key
cloudinaryApiSecret=your_cloudinary_api_secret

# Brevo (Sendinblue) Email Provider
brevo_api_key=your_brevo_api_key
BREVO_SENDER_NAME=HedgeNest
BREVO_SENDER_EMAIL=support@hedgenest.com

# KoraPay Payment Gateway
KORA_API_KEY=your_korapay_api_key

# MetaMap KYC (free tier: a single NIN flow). Client ID and flow ID are public.
METAMAP_CLIENT_ID=6ab535c4480e13fee5d88a2b
METAMAP_FLOW_TIER1_ID=6ab535c409a2b139f5fed01c
METAMAP_WEBHOOK_SECRET=your_metamap_webhook_secret
# Optional, paid MetaMap plans only: enables NIN name matching and duplicate-NIN detection
# METAMAP_CLIENT_SECRET=your_metamap_client_secret
# Only used when METAMAP_CLIENT_SECRET is set: random 32+ char secret to blind-index NINs
PII_HASH_SALT=your_random_32_plus_character_secret
# Webhook URL to register in MetaMap: <backend>/api/v1/kyc/webhook

# Frontend Client URL
CLIENT_URL=https://hedge-nest.vercel.app
FRONTEND_URL=https://hedge-nest.vercel.app
FRONTEND_VERIFY_URL=https://hedgenestwaitlist.vercel.app
